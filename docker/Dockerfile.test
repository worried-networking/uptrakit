# syntax=docker/dockerfile:1
#
# Multi-binary test image for system integration tests.
#
# Builds ALL five Uptrakit binaries in a single image so that testcontainers
# can spin up controller, agent, agent-ssh, scheduler, and mqtt containers
# from a single pre-built image. No ENTRYPOINT — each container specifies
# its command via testcontainers `with_cmd()`.
#
# Usage:
#   docker build -f docker/Dockerfile.test -t uptrakit-test:latest .
#
# The planner and builder stages share the same base image and cargo-chef
# workflow as the production Dockerfile, so Docker BuildKit can share
# layers when both images are built from the same source tree.

# ---------------------------------------------------------------------------
# Stage 1: Build the SvelteKit frontend SPA
# ---------------------------------------------------------------------------
FROM node:lts-bookworm-slim AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts && npm rebuild
COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Generate a Cargo dependency recipe with cargo-chef
# ---------------------------------------------------------------------------
FROM rust:1-bookworm AS planner

RUN cargo install cargo-chef --locked
WORKDIR /app
COPY . .
COPY --from=frontend-builder /app/frontend/build /app/frontend/build
RUN cargo chef prepare --recipe-path recipe.json

# ---------------------------------------------------------------------------
# Stage 3: Cook ALL workspace deps once, then build all binaries
# ---------------------------------------------------------------------------
FROM rust:1-bookworm AS builder

# Build tools required by aws-lc-sys and other native dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake clang pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-chef --locked

WORKDIR /app

# Cook dependencies first (cached as long as Cargo.toml/lock don't change)
COPY --from=planner /app/recipe.json recipe.json
# Cook controller-standalone first (rust-embed etc. are non-default; nats is the
# only forwarding feature — db-sqlite/oidc are always-on via the dep spec)
RUN cargo chef cook --release --recipe-path recipe.json \
    -p uptrakit-controller-standalone --features nats
# Cook remaining workspace deps (agent, scheduler, mqtt, etc.)
RUN cargo chef cook --release --recipe-path recipe.json

# Copy full source and built frontend
COPY . .
COPY --from=frontend-builder /app/frontend/build /app/frontend/build

# Build all binaries — standalone embeds the frontend (used by integration tests),
# lean controller is also built for completeness.
RUN cargo build --release \
    -p uptrakit-controller-standalone --features nats && \
    cargo build --release \
    -p uptrakit-controller --features nats && \
    cargo build --release \
    -p uptrakit-agent \
    -p uptrakit-agent-ssh \
    -p uptrakit-scheduler \
    -p uptrakit-mqtt

# ---------------------------------------------------------------------------
# Stage 4: Minimal runtime image
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd --system uptrakit && \
    useradd --system --gid uptrakit --create-home uptrakit

# Create data directories
RUN mkdir -p /data/config /data/state && \
    chown -R uptrakit:uptrakit /data

COPY --from=builder /app/target/release/uptrakit-controller-standalone /usr/local/bin/uptrakit-controller-standalone
COPY --from=builder /app/target/release/uptrakit-controller /usr/local/bin/uptrakit-controller
COPY --from=builder /app/target/release/uptrakit-agent /usr/local/bin/
COPY --from=builder /app/target/release/uptrakit-agent-ssh /usr/local/bin/
COPY --from=builder /app/target/release/uptrakit-scheduler /usr/local/bin/
COPY --from=builder /app/target/release/uptrakit-mqtt /usr/local/bin/

USER uptrakit
WORKDIR /data

ENV UPTRAKIT_CONFIG_DIR=/data/config \
    UPTRAKIT_STATE_DIR=/data/state
