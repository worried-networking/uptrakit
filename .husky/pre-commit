#!/usr/bin/env bash
# pre-commit: fast checks on staged files only (<30 s typical).
# Skip with: git commit --no-verify
set -euo pipefail

_GIT_DIR=$(git rev-parse --git-dir)
if [[ -f "$_GIT_DIR/MERGE_HEAD" ]]; then
  # ADR dup guard still runs for merge commits: the concluding commit of a
  # conflicted merge must fail on a duplicate ADR number (clean merges are
  # covered by pre-merge-commit; staged-file lints stay skipped here).
  bash ci/verify_adr_numbers.sh
  echo "[pre-commit] Merge commit — skipping checks."
  exit 0
fi
if [[ -f "$_GIT_DIR/REVERT_HEAD" ]]; then
  echo "[pre-commit] Revert commit — skipping checks."
  exit 0
fi

die() { printf '[pre-commit] %s\n' "$1" >&2; exit 1; }
cleanup_pre_commit_tmp() { rm -f ${TYPE_CHANGED_TMP:+"$TYPE_CHANGED_TMP"} ${STAGED_PATHS_TMP:+"$STAGED_PATHS_TMP"}; }
trap cleanup_pre_commit_tmp EXIT

TYPE_CHANGED_TMP=$(mktemp) || die 'Failed to allocate temp file for type-changed path detection.'
git diff --cached --name-only --diff-filter=T -z >"$TYPE_CHANGED_TMP" || { rm -f "$TYPE_CHANGED_TMP"; die 'Failed to inspect staged type-changed paths.'; }
mapfile -d '' -t TYPE_CHANGED <"$TYPE_CHANGED_TMP"
rm -f "$TYPE_CHANGED_TMP"
if (( ${#TYPE_CHANGED[@]} > 0 )); then die 'Type-changed staged entries detected. Restore or restage them before committing.'; fi

STAGED_PATHS_TMP=$(mktemp) || die 'Failed to allocate temp file for staged-path collection.'
git diff --cached --name-only --diff-filter=ACMR -z >"$STAGED_PATHS_TMP" || { rm -f "$STAGED_PATHS_TMP"; die 'Failed to collect staged paths.'; }
mapfile -d '' -t STAGED_PATHS <"$STAGED_PATHS_TMP"
rm -f "$STAGED_PATHS_TMP"

RUST_FILES=()
MARKDOWN_FILES=()
FRONTEND_ESLINT_FILES=()
FRONTEND_PRETTIER_FILES=()
ROUTES_RS_FILES=()
ACTIONS_FILES=()
ADR_FILES=()
WEBSITE_DOCS_TOUCHED=0
AGENTS_MD_TOUCHED=0

WEBSITE_DOC_PREFIXES=()
REPO_ROOT=$(git rev-parse --show-toplevel)
if [[ -d website/content/docs ]]; then
  while IFS= read -r -d '' link; do
    target=$(readlink "$link") || continue
    # Two-cd sequence resolves relative symlink targets correctly on macOS (BSD readlink lacks -f).
    abs=$(cd "$(dirname "$link")" && cd "$target" 2>/dev/null && pwd) || continue
    rel="${abs#"$REPO_ROOT/"}"
    [[ "$rel" != "$abs" ]] && WEBSITE_DOC_PREFIXES+=("$rel/")
  done < <(find website/content/docs -maxdepth 1 -type l -print0 2>/dev/null || true)
fi

for path in "${STAGED_PATHS[@]}"; do
  case "$path" in
    crates/*.rs) RUST_FILES+=("$path") ;;
    *.md) MARKDOWN_FILES+=("$path") ;;
    .github/workflows/*.yml|.github/workflows/*.yaml) ACTIONS_FILES+=("$path") ;;
  esac
  case "$path" in
    frontend/*.js|frontend/*.cjs|frontend/*.mjs|frontend/*.ts|frontend/*.cts|frontend/*.mts|frontend/*.svelte)
      FRONTEND_ESLINT_FILES+=("${path#frontend/}")
      FRONTEND_PRETTIER_FILES+=("${path#frontend/}")
      ;;
    frontend/*.css|frontend/*.scss|frontend/*.html|frontend/*.json|frontend/*.md|frontend/*.yaml|frontend/*.yml)
      FRONTEND_PRETTIER_FILES+=("${path#frontend/}")
      ;;
  esac
  [[ "$path" =~ ^crates/ui/web-api/src/routes/.*\.rs$ ]] && ROUTES_RS_FILES+=("$path")
  [[ "${path##*/}" == "AGENTS.md" ]] && AGENTS_MD_TOUCHED=1
  [[ "$path" == docs/adr/* ]] && ADR_FILES+=("$path")
  if [[ "$path" == website/* ]]; then
    WEBSITE_DOCS_TOUCHED=1
  else
    for prefix in "${WEBSITE_DOC_PREFIXES[@]}"; do
      if [[ "$path" == "$prefix"* ]]; then
        WEBSITE_DOCS_TOUCHED=1
        break
      fi
    done
  fi
done

require_worktree_paths() {
  local label="$1"; shift
  local path
  for path in "$@"; do
    [[ -e "$path" ]] || die "$label path is staged but missing in the working tree: $path"
  done
}

require_rust_edition_2024() {
  local path dir manifest
  for path in "$@"; do
    dir=$(dirname "$path")
    manifest=''
    while :; do
      if [[ -f "$dir/Cargo.toml" ]]; then manifest="$dir/Cargo.toml"; break; fi
      [[ "$dir" == "." || "$dir" == "/" ]] && break
      dir=$(dirname "$dir")
    done
    [[ -n "$manifest" ]] || die "Could not find Cargo.toml for staged Rust file: $path"
    if awk '
      /^\[package\]/ { in_section=1; next }
      /^\[/ { in_section=0 }
      in_section && /^edition *= *"2024"([[:space:]]*#.*)?$/ { found=1 }
      in_section && /^edition\.workspace *= *true([[:space:]]*#.*)?$/ { found=1 }
      END { exit found ? 0 : 1 }
    ' "$manifest"; then
      continue
    fi
    die "Rust edition for $path is not 2024. Mixed-edition workspaces require revisiting this hook."
  done
}

if (( ${#ROUTES_RS_FILES[@]} > 0 )); then
  command -v python3 >/dev/null 2>&1 || die 'python3 is required for staged routes/ Rust files.'
  require_worktree_paths 'routes Rust' "${ROUTES_RS_FILES[@]}"
  echo '[pre-commit] Verifying DB access policy for staged routes/ files...'
  # Full stale-entry validation runs in CI; this check only covers staged files.
  python3 ci/verify_db_access_policy.py "${ROUTES_RS_FILES[@]}"
  echo '[pre-commit] Scanning routes/ for legacy error-match patterns...'
  # Script scans full routes/ dir; gated on staged routes files to keep hook fast.
  ./scripts/check_legacy_error_matches.sh
fi

if (( ${#RUST_FILES[@]} > 0 )); then
  command -v rustfmt >/dev/null 2>&1 || die 'rustfmt is required for staged Rust files. Install it with: rustup component add rustfmt'
  require_worktree_paths 'Rust' "${RUST_FILES[@]}"
  require_rust_edition_2024 "${RUST_FILES[@]}"
  echo '[pre-commit] Running rustfmt check on staged Rust files...'
  # Keep this edition flag aligned with the staged crate's Cargo.toml edition field.
  rustfmt --edition 2024 --check -- "${RUST_FILES[@]}"
fi

if (( ${#MARKDOWN_FILES[@]} > 0 )); then
  command -v markdownlint >/dev/null 2>&1 || die 'markdownlint is required for staged Markdown files.'
  require_worktree_paths 'Markdown' "${MARKDOWN_FILES[@]}"
  echo '[pre-commit] Running markdownlint on staged Markdown files...'
  markdownlint --config .markdownlint.json -- "${MARKDOWN_FILES[@]}"
fi

if (( ${#ACTIONS_FILES[@]} > 0 )); then
  if ! command -v actionlint >/dev/null 2>&1; then
    printf '[pre-commit] WARNING: actionlint not installed — skipping workflow lint.\n' >&2
    printf '[pre-commit] Install: https://github.com/rhysd/actionlint/blob/v1.7.12/docs/install.md\n' >&2
  else
    require_worktree_paths 'Actions' "${ACTIONS_FILES[@]}"
    echo '[pre-commit] Running actionlint on staged workflow files...'
    actionlint "${ACTIONS_FILES[@]}"
  fi
fi

if (( WEBSITE_DOCS_TOUCHED )); then
  if ! command -v zola >/dev/null 2>&1; then
    printf '[pre-commit] WARNING: zola not installed — skipping website link check.\n' >&2
    printf '[pre-commit] Install: https://www.getzola.org/documentation/getting-started/installation/\n' >&2
  else
    echo '[pre-commit] Running zola check...'
    # --skip-external-links: external link verification runs in CI; avoid network I/O in pre-commit.
    # zola check validates the whole site — pre-existing broken links in unrelated docs will also fail.
    ( cd website && zola check --skip-external-links )
  fi
fi

if (( AGENTS_MD_TOUCHED )); then
  echo '[pre-commit] Verifying AGENTS.md size budgets...'
  # Repo-wide check (sub-second); gated on staged AGENTS.md files to keep the hook fast.
  bash ci/verify_agents_md_budget.sh
fi

if (( ${#ADR_FILES[@]} > 0 )); then
  echo '[pre-commit] Verifying ADR numbers...'
  bash ci/verify_adr_numbers.sh
  echo '[pre-commit] Checking ADR TOC staleness...'
  bash scripts/regen-adr-toc.sh --check
  if ! command -v adrs >/dev/null 2>&1; then
    printf '[pre-commit] WARNING: adrs not installed — skipping adrs doctor (CI enforces).\n' >&2
    printf '[pre-commit] Install: cargo install adrs --locked\n' >&2
  else
    echo '[pre-commit] Running adrs doctor...'
    adrs doctor
  fi
fi

if (( ${#FRONTEND_ESLINT_FILES[@]} > 0 || ${#FRONTEND_PRETTIER_FILES[@]} > 0 )); then
  if [[ ! -d frontend/node_modules ]]; then
    echo '[pre-commit] frontend/node_modules not found, skipping frontend checks.'
    echo '[pre-commit] Run: cd frontend && npm install'
  else
    [[ -x frontend/node_modules/.bin/eslint ]] || die 'frontend/node_modules/.bin/eslint is missing. Re-run: cd frontend && npm install'
    [[ -x frontend/node_modules/.bin/prettier ]] || die 'frontend/node_modules/.bin/prettier is missing. Re-run: cd frontend && npm install'
    if (( ${#FRONTEND_ESLINT_FILES[@]} > 0 )); then
      require_worktree_paths 'Frontend ESLint' "${FRONTEND_ESLINT_FILES[@]/#/frontend/}"
      echo '[pre-commit] Running ESLint on staged frontend files...'
      # frontend/package.json is the canonical source for non-path ESLint/Prettier flags.
      # Update these extension allowlists if frontend lint/format config changes.
      ( cd frontend && ./node_modules/.bin/eslint -- "${FRONTEND_ESLINT_FILES[@]}" )
    fi
    if (( ${#FRONTEND_PRETTIER_FILES[@]} > 0 )); then
      require_worktree_paths 'Frontend Prettier' "${FRONTEND_PRETTIER_FILES[@]/#/frontend/}"
      echo '[pre-commit] Running Prettier on staged frontend files...'
      # frontend/package.json is the canonical source for non-path ESLint/Prettier flags.
      # Update these extension allowlists if frontend lint/format config changes.
      ( cd frontend && ./node_modules/.bin/prettier --check -- "${FRONTEND_PRETTIER_FILES[@]}" )
    fi
  fi
fi
