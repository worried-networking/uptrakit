#!/usr/bin/env bash
# pre-push: thorough checks run on every push.
# Skip with: git push --no-verify
set -euo pipefail

echo "[pre-push] Running cargo fmt check..."
cargo fmt --all -- --check

echo "[pre-push] Running markdownlint..."
command -v markdownlint >/dev/null 2>&1 || { echo "[pre-push] markdownlint is required." >&2; exit 1; }
TRACKED_MARKDOWN_TMP=$(mktemp) || { echo "[pre-push] Failed to allocate temp file for tracked Markdown collection." >&2; exit 1; }
cleanup_tracked_markdown_tmp() { rm -f ${TRACKED_MARKDOWN_TMP:+"$TRACKED_MARKDOWN_TMP"}; }
trap cleanup_tracked_markdown_tmp EXIT
git ls-files -z -- '*.md' >"$TRACKED_MARKDOWN_TMP" || { echo "[pre-push] Failed to collect tracked Markdown files." >&2; exit 1; }
mapfile -d '' -t TRACKED_MARKDOWN <"$TRACKED_MARKDOWN_TMP"
rm -f "$TRACKED_MARKDOWN_TMP"
TRACKED_MARKDOWN_TMP=''
EXISTING_MARKDOWN=()
for path in "${TRACKED_MARKDOWN[@]}"; do
  [[ -e "$path" ]] && EXISTING_MARKDOWN+=("$path")
done
if (( ${#EXISTING_MARKDOWN[@]} > 0 )); then
  markdownlint --config .markdownlint.json -- "${EXISTING_MARKDOWN[@]}"
fi

echo "[pre-push] Running cargo check (db-sqlite)..."
cargo check --no-default-features --features db-sqlite

echo "[pre-push] Running cargo clippy (db-sqlite)..."
cargo clippy --all-targets --no-default-features --features db-sqlite

echo "[pre-push] Running cargo deny check..."
# Capture output so we can also detect warnings (cargo deny exits 0 on warn-level findings).
if deny_output=$(cargo deny --color=never check 2>&1); then
  printf '%s\n' "$deny_output"
  if printf '%s\n' "$deny_output" | grep -qE '^warning\['; then
    echo "[pre-push] cargo deny check produced warnings — treating as errors."
    echo "[pre-push] Fix warnings or add documented skip/allow entries to deny.toml."
    exit 1
  fi
else
  printf '%s\n' "$deny_output"
  exit 1
fi

echo "[pre-push] Running semantic boundary check..."
python3 ci/check_plugin_semantic_boundary.py

echo "[pre-push] Running cargo test (db-sqlite)..."
if command -v cargo-nextest >/dev/null 2>&1; then
  cargo nextest run --no-default-features --features db-sqlite
else
  cargo test --no-default-features --features db-sqlite
fi

# --- Sentrux architectural rules ---
if command -v sentrux >/dev/null 2>&1; then
  echo "[pre-push] Running sentrux check (advisory)..."
  sentrux check . || echo "[pre-push] sentrux check failed — advisory only, not blocking push."
else
  echo "[pre-push] sentrux not found, skipping architectural check."
  echo "[pre-push] Install: curl -fsSL https://raw.githubusercontent.com/sentrux/sentrux/main/install.sh | sh"
fi

# --- Frontend ---
if [ -d frontend/node_modules ]; then
  echo "[pre-push] Running npm check..."
  npm run check --prefix frontend
  echo "[pre-push] Running npm test..."
  npm run test --prefix frontend
  echo "[pre-push] Running npm build..."
  npm run build --prefix frontend
else
  echo "[pre-push] frontend/node_modules not found, skipping frontend checks."
  echo "[pre-push] Run: cd frontend && npm install"
fi
