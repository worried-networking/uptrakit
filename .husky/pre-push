#!/usr/bin/env bash
# pre-push: thorough checks run on every push.
# Skip with: git push --no-verify
set -euo pipefail

if [[ -x .beads/hooks/pre-push ]]; then
  .beads/hooks/pre-push "$@"
fi

# Slurp stdin: lines are "<local-ref> <local-sha1> <remote-ref> <remote-sha1>"
# When called by git, $1 is the remote name. When triggered manually, $1 is unset.
# Skip early only when called by git and there is nothing to verify:
#   - Branch deletions: local-sha1 == 0000...0000
#   - Tag-only pushes:  every local-ref starts with refs/tags/
PUSH_STDIN=$(cat)
ZERO_SHA="0000000000000000000000000000000000000000"
if [[ -n "${1:-}" ]]; then
  if [[ -z "$PUSH_STDIN" ]]; then
    echo "[pre-push] Nothing to push — skipping checks."
    exit 0
  fi
  if ! awk -v zero="$ZERO_SHA" 'NF>=2 && $2!=zero {found=1; exit} END {exit !found}' <<<"$PUSH_STDIN"; then
    echo "[pre-push] Branch deletion — skipping checks."
    exit 0
  fi
  if ! awk '$1 !~ /^refs\/tags\// {found=1; exit} END {exit !found}' <<<"$PUSH_STDIN"; then
    echo "[pre-push] Tag-only push — skipping checks."
    exit 0
  fi
fi

echo "[pre-push] Running cargo fmt check..."
cargo fmt --all -- --check

echo "[pre-push] Running markdownlint..."
command -v markdownlint >/dev/null 2>&1 || { echo "[pre-push] markdownlint is required." >&2; exit 1; }
TRACKED_MARKDOWN_TMP=$(mktemp) || { echo "[pre-push] Failed to allocate temp file for tracked Markdown collection." >&2; exit 1; }
cleanup_tracked_markdown_tmp() { rm -f ${TRACKED_MARKDOWN_TMP:+"$TRACKED_MARKDOWN_TMP"}; }
trap cleanup_tracked_markdown_tmp EXIT
git ls-files -z -- '*.md' >"$TRACKED_MARKDOWN_TMP" || { echo "[pre-push] Failed to collect tracked Markdown files." >&2; exit 1; }
mapfile -d '' -t TRACKED_MARKDOWN <"$TRACKED_MARKDOWN_TMP"
rm -f "$TRACKED_MARKDOWN_TMP"
TRACKED_MARKDOWN_TMP=''
EXISTING_MARKDOWN=()
for path in "${TRACKED_MARKDOWN[@]}"; do
  [[ -e "$path" ]] && EXISTING_MARKDOWN+=("$path")
done
if (( ${#EXISTING_MARKDOWN[@]} > 0 )); then
  markdownlint --config .markdownlint.json -- "${EXISTING_MARKDOWN[@]}"
fi

echo "[pre-push] Running zola check..."
if command -v zola >/dev/null 2>&1; then
  # Identical to the `Validate site` step in .github/workflows/website.yml — external
  # links included. pre-commit skips them to stay offline-safe; this is the parity gate.
  ( cd website && zola check )
else
  printf '[pre-push] WARNING: zola not installed — skipping website check (CI enforces).\n' >&2
  printf '[pre-push] Install: cargo install zola --version 0.23.3\n' >&2
fi

echo "[pre-push] Running cargo check (db-sqlite)..."
cargo check --no-default-features --features db-sqlite

echo "[pre-push] Running cargo clippy (db-sqlite)..."
cargo clippy --all-targets --no-default-features --features db-sqlite

echo "[pre-push] Running cargo deny check..."
REMOTE="${1:-origin}"
DENY_BASE=""
if _ref=$(git symbolic-ref "refs/remotes/$REMOTE/HEAD" 2>/dev/null); then
  DENY_BASE="$REMOTE/${_ref##*/}"
elif git rev-parse --verify --quiet "$REMOTE/main" > /dev/null 2>&1; then
  DENY_BASE="$REMOTE/main"
elif git rev-parse --verify --quiet "$REMOTE/master" > /dev/null 2>&1; then
  DENY_BASE="$REMOTE/master"
else
  echo "[pre-push] Cannot determine base branch for remote '$REMOTE' — running full deny check."
fi
bash scripts/check_deny.sh ${DENY_BASE:+"$DENY_BASE"}

echo "[pre-push] Running semantic boundary check..."
python3 ci/check_plugin_semantic_boundary.py

echo "[pre-push] Running action-security-declarations check..."
python3 ci/verify_action_security_declarations.py

echo "[pre-push] Running no-orphan-modules check..."
python3 ci/verify_no_orphan_modules.py

echo "[pre-push] Running no-legacy-identifiers check..."
bash ci/verify_no_legacy_identifiers.sh

echo "[pre-push] Running typed-audit-actions check..."
bash ci/verify_typed_audit_actions.sh

echo "[pre-push] Running no-inline-query-params check..."
bash ci/verify_no_inline_query_params.sh

echo "[pre-push] Running dataload-declares-params check..."
bash ci/verify_dataload_declares_params.sh

echo "[pre-push] Running no-new-cfg-not-feature check..."
bash ci/verify_no_new_cfg_not_feature.sh

echo "[pre-push] Running engine-owned-entities check..."
bash ci/verify_engine_owned_entities.sh

echo "[pre-push] Running raw-sql-expect-taxonomy check..."
bash ci/verify_raw_sql_expect_taxonomy.sh

echo "[pre-push] Verifying ADR numbers..."
bash ci/verify_adr_numbers.sh
echo "[pre-push] Checking ADR TOC staleness..."
bash scripts/regen-adr-toc.sh --check
if command -v adrs >/dev/null 2>&1; then
  echo "[pre-push] Running adrs doctor..."
  adrs doctor
else
  echo "[pre-push] WARNING: adrs not installed — skipping adrs doctor (CI enforces)." >&2
fi

echo "[pre-push] Running audit coverage check..."
cargo xtask audit-coverage-check

echo "[pre-push] Running openapi-client coverage check..."
cargo xtask openapi-client-check

echo "[pre-push] Running cargo test (db-sqlite)..."
if command -v cargo-nextest >/dev/null 2>&1; then
  cargo nextest run --no-default-features --features db-sqlite
else
  cargo test --no-default-features --features db-sqlite
fi

# Doctests run at CI parity (--all-features). Must use `cargo test` — nextest does not
# run doctests. uptrakit-mqtt-runtime is excluded: it sets `[lib] doctest = false` and
# `--doc` would otherwise override that opt-out.
echo "[pre-push] Running doctests (--all-features)..."
cargo test --workspace --all-features --doc --exclude uptrakit-mqtt-runtime

# --- Frontend ---
if [ -d frontend/node_modules ]; then
  echo "[pre-push] Running npm check..."
  npm run check --prefix frontend
  echo "[pre-push] Running npm test..."
  npm run test --prefix frontend
  echo "[pre-push] Running npm build..."
  npm run build --prefix frontend
else
  echo "[pre-push] frontend/node_modules not found, skipping frontend checks."
  echo "[pre-push] Run: cd frontend && npm install"
fi
