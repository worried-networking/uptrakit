# Uptrakit Docker Compose environment variables
# Copy this file to .env and fill in the required values.

# ---------- Required ----------

# Master encryption key (64-character hex string).
# Generate with: openssl rand -hex 32
UPTRAKIT_MASTER_KEY=

# ---------- Database ----------

# Leave empty for SQLite (default), or set a PostgreSQL URL with --profile postgres.
# DB_URL=postgresql://uptrakit:changeme@postgres:5432/uptrakit
# POSTGRES_PASSWORD=changeme

# ---------- Auto-enrollment ----------

# Pre-shared secrets for automatic service enrollment.
# Set any random string; the controller hashes it at startup.
# Services present the same plaintext value to auto-enroll.

# Tenant enrollment token (for agent-ssh). Default: 1 use, 5-min TTL.
# ENROLLMENT_TOKEN=
# ENROLLMENT_TOKEN_MAX_USES=1
# ENROLLMENT_TOKEN_TTL=300

# System enrollment token (for mqtt, scheduler). Adjust max_uses for
# the number of system services that will enroll. Default: 1 use, 5-min TTL.
# SYSTEM_ENROLLMENT_TOKEN=
# SYSTEM_ENROLLMENT_TOKEN_MAX_USES=2
# SYSTEM_ENROLLMENT_TOKEN_TTL=300

# ---------- NATS ----------

# Required when using --profile scheduler or --profile full.
# NATS_URL=nats://nats:4222

# ---------- OIDC (optional) ----------

# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
