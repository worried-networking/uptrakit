{
	"name": "uptrakit-controller-frontend",
	"version": "0.0.7",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:behavior": "playwright test --config=playwright.behavior.config.ts",
		"test:e2e:parity": "playwright test --config=playwright.parity.config.ts",
		"test:e2e:check-buckets": "node scripts/check-e2e-buckets.mjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"gen:api": "svelte-kit sync && openapi-ts"
	},
	"overrides": {
		"cookie": "^1.1.1",
		"js-yaml": "^4.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@playwright/test": "^1.62.1",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/markdown-it-emoji": "^3.0.1",
		"@types/markdown-it-footnote": "^3.0.4",
		"@vitest/coverage-v8": "^4.1.10",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@lucide/svelte": "^1.33.0",
		"dompurify": "^3.4.14",
		"markdown-it": "^15.0.0",
		"markdown-it-emoji": "^3.1.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-github-alerts": "^1.0.1",
		"markdown-it-task-lists": "^2.1.1"
	}
}
