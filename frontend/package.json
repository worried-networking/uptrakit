{
	"name": "uptrakit-controller-frontend",
	"version": "0.0.5",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:behavior": "playwright test --config=playwright.behavior.config.ts",
		"test:e2e:parity": "playwright test --config=playwright.parity.config.ts",
		"test:e2e:check-buckets": "node scripts/check-e2e-buckets.mjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"gen:api": "openapi-ts"
	},
	"overrides": {
		"cookie": "^1.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@playwright/test": "^1.61.0",
		"@skeletonlabs/skeleton": "^4.15.2",
		"@skeletonlabs/skeleton-svelte": "^4.15.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/markdown-it": "^14.1.2",
		"@types/markdown-it-emoji": "^3.0.1",
		"@types/markdown-it-footnote": "^3.0.4",
		"@vitest/coverage-v8": "^4.1.9",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@lucide/svelte": "^1.18.0",
		"dompurify": "^3.4.11",
		"markdown-it": "^14.2.0",
		"markdown-it-emoji": "^3.0.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-github-alerts": "^1.0.1",
		"markdown-it-task-lists": "^2.1.1"
	}
}
